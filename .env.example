# Banco de dados PostgreSQL (Neon — banco na nuvem, acessível de qualquer
# dispositivo/rede). Pegue essa string em console.neon.tech > seu projeto >
# Connection string (use a variante "pooled" para a aplicação).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-12345.sa-east-1.aws.neon.tech/atendiplus?sslmode=require"

# NextAuth
# Gere um valor aleatório: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
# Em dev acessando só pela própria máquina, deixe localhost. Se for acessar
# pelo celular via IP da rede local, troque pelo IP do PC (ex: http://192.168.0.10:3000).
NEXTAUTH_URL="http://localhost:3000"

# Upload de arquivos — Cloudflare R2 (armazenamento na nuvem, S3-compatível).
# Crie um bucket em dash.cloudflare.com > R2, e um token de API (R2 > Manage
# API tokens) com permissão de leitura/escrita nesse bucket.
R2_ACCOUNT_ID="seu-account-id-cloudflare"
R2_ACCESS_KEY_ID="sua-access-key-id"
R2_SECRET_ACCESS_KEY="sua-secret-access-key"
R2_BUCKET_NAME="atendiplus-uploads"
# URL pública do bucket (ative "Public Access" no bucket e copie a URL
# r2.dev, ou configure um domínio customizado). Usada só para logos/avatares.
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"
MAX_UPLOAD_SIZE_MB=10

# Ambiente
NODE_ENV="development"
