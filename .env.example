# Banco de dados PostgreSQL
# Ex: postgresql://usuario:senha@localhost:5432/atendiplus?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/atendiplus?schema=public"

# NextAuth
# Gere um valor aleatório: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# Upload de arquivos (armazenamento local em desenvolvimento)
# Em produção, recomenda-se trocar por um bucket S3-compatível.
UPLOADS_DIR="./public/uploads"
MAX_UPLOAD_SIZE_MB=10

# Ambiente
NODE_ENV="development"
